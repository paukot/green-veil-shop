# TLS edge for a Cloudflare-proxied origin on a custom port.
#
# Cloudflare runs in "Full (strict)" mode and validates the Origin Certificate
# mounted at /certs (uploaded with `./deploy.sh cert`). Public ACME is off:
# Let's Encrypt cannot validate a non-standard port behind Cloudflare.
{
	auto_https off

	servers {
		# Only Cloudflare's published ranges may vouch for the visitor address.
		# Refresh from https://www.cloudflare.com/ips/ when Cloudflare changes them.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

:8443 {
	tls /certs/origin.pem /certs/origin.key

	encode zstd gzip

	reverse_proxy app:8080 {
		# Hand Laravel the real visitor address (its trustProxies covers this
		# container's bridge IP) instead of Cloudflare's edge address.
		header_up X-Forwarded-For {client_ip}
		header_up X-Real-IP {client_ip}
	}

	log {
		output stdout
		format json
	}
}
