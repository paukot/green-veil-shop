APP_NAME="Green Veil"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_DOMAIN=example.com

# Custom web port (e.g. 8080, 8888) so panels/reverse proxies can access it without port 80/443 conflict
APP_PORT=8080
SSL_MODE=off

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# --- Database (MySQL container) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=green_veil_cosmetic_shop
DB_USERNAME=green_veil
DB_PASSWORD=secret
DB_ROOT_PASSWORD=secret

# Host port forwarding (binds only to localhost; uses 3307 so it doesn't conflict with host MySQL 3306)
FORWARD_DB_PORT=127.0.0.1:3307

# --- Cache, Session, & Queue (Redis container) ---
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Host port forwarding (binds only to localhost; uses 6380 so it doesn't conflict with host Redis 6379)
FORWARD_REDIS_PORT=127.0.0.1:6380

# --- Mail ---
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur
