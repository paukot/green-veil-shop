# Copy to .deploy.env (git-ignored) to run `./deploy.sh` from a workstation.
# Real environment variables override these values. CI sets them from secrets.

# Server address and the SSH port. KVM hosts usually do not expose port 22.
DEPLOY_HOST=203.0.113.10
DEPLOY_SSH_PORT=2222
DEPLOY_USER=deploy

# The git checkout on the server (the repository is cloned/updated there; the image is built there).
DEPLOY_PATH=/var/www/green-veil-cosmetic-shop

# Branch to deploy (default: the branch the server checkout is on).
# DEPLOY_BRANCH=master

# Only for a brand new server: where to clone from when DEPLOY_PATH is not a checkout yet.
# DEPLOY_REPO_URL=https://github.com/<owner>/<repo>.git

# Optional: a dedicated key and known_hosts file instead of ssh's defaults.
# DEPLOY_SSH_KEY=~/.ssh/greenveil_deploy
# DEPLOY_KNOWN_HOSTS=~/.ssh/known_hosts

# Public URL, written into .env the first time it is created on the server.
# Use a one-level subdomain (shop.example.com): Cloudflare's free certificate
# does not cover www.shop.example.com.
DEPLOY_APP_URL=https://shop.example.com

# Port the Caddy proxy listens on, on the server (default 8443). Every app on the
# same server needs its own port; point a Cloudflare Origin Rule at the same port.
# DEPLOY_PUBLIC_PORT=40000
